# 复制为 .env.local（本地开发）并在 Vercel Dashboard → Settings → Environment Variables 中逐项设置
# 注意：SUPABASE_SERVICE_ROLE_KEY 只用于服务端（api/clear.js），绝不能出现在前端代码或提交到公开仓库。

# Supabase 项目地址（在 Supabase Dashboard → Settings → API → Project URL）
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase 匿名公开 key（anon / publishable key，前端不直接使用，仅服务端调用 PostgREST）
SUPABASE_ANON_KEY=<anon key>

# Supabase service_role key（服务端专用，绕过 RLS，仅用于教师清空数据）
SUPABASE_SERVICE_ROLE_KEY=<service_role key>

# 教师清空班级数据的 PIN（4–8 位数字，教师本人设定并保管，不要写进代码仓库）
TEACHER_PIN=1234
